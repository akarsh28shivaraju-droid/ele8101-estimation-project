function step3_ekf_racetrack_final()
    % --- 1. Configuration ---
    C = config_step3();
    
    % --- 2. Simulation (Ground Truth) ---
    data = simulate_step3(C);
    
    % --- 3. EKF Initialization ---
    num_beacons = size(C.beacons_xy, 1);
    x_est = [C.s0; C.v0]; 
    P = eye(2) * 10;
    Q = [0.0001, 0; 0, 0.001]; % Lowered Q for smoother tracking
    R = eye(num_beacons) * (C.sigma_range^2); 
    
    X_est_all = zeros(2, C.N_steps + 1);
    X_est_all(:,1) = x_est;
    K_history = zeros(C.N_steps, 1); 
    
    % --- 4. The EKF Loop ---
    for k = 1:C.N_steps
        % A. PREDICTION
        F = [1, C.Ts; 0, 1];        
        x_pred = F * x_est;
        x_pred(1) = mod(x_pred(1), C.S_max); % Reset distance after each lap
        P_pred = F * P * F' + Q;
        
        % B. UPDATE (Synchronized for 3 Beacons)
        z = data.Y(:, k);           
        s_p = x_pred(1); 
        
        [veh_x, veh_y, dx_ds, dy_ds] = get_track_geometry(s_p, C);
        
        h_pred = zeros(num_beacons, 1);
        H = zeros(num_beacons, 2);
        
        for i = 1:num_beacons
            bx = C.beacons_xy(i,1); by = C.beacons_xy(i,2);
            range = sqrt((veh_x - bx)^2 + (veh_y - by)^2);
            h_pred(i) = range;
            
            % Jacobian (Measurement Sensitivity)
            dr_dx = (veh_x - bx) / range;
            dr_dy = (veh_y - by) / range;
            H(i,1) = dr_dx * dx_ds + dr_dy * dy_ds; 
            H(i,2) = 0; 
        end
        
        S = H * P_pred * H' + R;
        K = P_pred * H' / S;
        K_history(k) = K(1,1); 
        
        x_est = x_pred + K * (z - h_pred);
        P = (eye(2) - K * H) * P_pred;
        
        X_est_all(:, k+1) = x_est;
    end

    % --- 5. Visualization ---
    figure('Name', 'EKF Race Track Analysis');
    subplot(2,1,1);
    plot(data.t, data.s_true, 'k', 'LineWidth', 1.5); hold on;
    plot(data.t, X_est_all(1,:), 'r--');
    title('Total Distance Coverage (Lap Wrapping)');
    ylabel('Arc Length [m]'); grid on;
    
    subplot(2,1,2);
    plot(data.t(2:end), K_history, 'm');
    title('Kalman Gain: Spikes indicate geometry transitions');
    xlabel('Time [s]'); ylabel('K Gain'); grid on;

    figure('Name', '2D Trajectory Reconstruction');
    [tx, ty] = get_track_geometry_vec(data.s_true, C);
    [ex, ey] = get_track_geometry_vec(X_est_all(1,:), C);
    
    plot(tx, ty, 'k-', 'LineWidth', 2); hold on;
    plot(ex, ey, 'r--', 'LineWidth', 1.5);
    plot(C.beacons_xy(:,1), C.beacons_xy(:,2), 'bs', 'MarkerSize', 10, 'MarkerFaceColor', 'b');
    title('Final 2D Race Track Path');
    xlabel('X [m]'); ylabel('Y [m]'); axis equal; grid on;
    legend('True Track', 'EKF Estimate', 'Beacons');
end

% --- GEOMETRY ENGINE ---
function [x, y, dx_ds, dy_ds] = get_track_geometry(s, C)
    L = C.L; R = C.R; semi = pi*R;
    if s <= L % Top Straight
        x = s; y = R; dx_ds = 1; dy_ds = 0;
    elseif s <= L + semi % Right Turn
        theta = (s - L) / R - pi/2;
        x = L + R*cos(theta); y = R*sin(theta);
        dx_ds = -sin(theta); dy_ds = cos(theta);
    elseif s <= 2*L + semi % Bottom Straight
        x = L - (s - (L + semi)); y = -R; dx_ds = -1; dy_ds = 0;
    else % Left Turn
        theta = (s - (2*L + semi)) / R + pi/2;
        x = R*cos(theta); y = R*sin(theta);
        dx_ds = -sin(theta); dy_ds = cos(theta);
    end
end

function [xv, yv] = get_track_geometry_vec(sv, C)
    xv = zeros(size(sv)); yv = zeros(size(sv));
    for i = 1:length(sv)
        [xv(i), yv(i)] = get_track_geometry(sv(i), C);
    end
end

% --- CONFIG AND SIMULATION ---
function C = config_step3()
    C.Ts = 0.05; C.N_steps = 2000; C.sigma_range = 1.5;
    C.L = 100; C.R = 50; C.S_max = 2*C.L + 2*pi*C.R;
    % Added third beacon for improved observability
    C.beacons_xy = [50, 70; 50, -70; -50, 0]; 
    C.s0 = 0; C.v0 = 10; C.qv = 0.1;
end

function data = simulate_step3(C)
    s_true = zeros(1, C.N_steps + 1);
    v_true = zeros(1, C.N_steps + 1);
    num_beacons = size(C.beacons_xy, 1);
    Y = zeros(num_beacons, C.N_steps);
    s_true(1) = C.s0; v_true(1) = C.v0;
    for k = 1:C.N_steps
        v_true(k+1) = v_true(k) + C.qv * randn;
        s_true(k+1) = mod(s_true(k) + C.Ts * v_true(k), C.S_max);
        [px, py] = get_track_geometry(s_true(k+1), C);
        for i = 1:num_beacons
            dist = sqrt((px - C.beacons_xy(i,1))^2 + (py - C.beacons_xy(i,2))^2);
            Y(i,k) = dist + C.sigma_range * randn;
        end
    end
    data.s_true = s_true; data.Y = Y; data.t = 0:C.Ts:C.N_steps*C.Ts;
end
